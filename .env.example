# ── Site ────────────────────────────────────────────────────────────
# Public URL, used for absolute link-preview (og:image) URLs.
# Optional on Vercel (falls back to the production domain).
NEXT_PUBLIC_SITE_URL=https://169pi-kappa.vercel.app

# ── Alpie (OpenAI-compatible chat completions) ──────────────────────
ALPIE_API_BASE=https://api.169pi.com/v1
ALPIE_API_KEY=
ALPIE_MODEL=alpie-32b

# ── GitHub OAuth app ────────────────────────────────────────────────
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# Must exactly match the OAuth app's "Authorization callback URL".
# Local: http://localhost:3001/api/auth/callback
GITHUB_REDIRECT_URI=https://169pi-kappa.vercel.app/api/auth/callback

# Cookie signing. Generate with: openssl rand -base64 32
SESSION_SECRET=

# Optional server-side token for public repo stats
# (raises the rate limit from 60/hr per IP to 5,000/hr).
GITHUB_TOKEN=

# ── Repos (all optional; defaults shown) ────────────────────────────
# Star count, "Star" step and star auto-check
GITHUB_STARS_OWNER=169Pi
GITHUB_STARS_REPO=Alpie-Core
# PR count, contributor leaderboard
GITHUB_STATS_OWNER=169Pi
GITHUB_STATS_REPO=.github
# Fork / PR target used by the sign-in status check
GITHUB_PROFILE_OWNER=169Pi
GITHUB_PROFILE_REPO=.github

# Client-side copies used for links on the page
NEXT_PUBLIC_GITHUB_OWNER=169Pi
NEXT_PUBLIC_GITHUB_REPO=Alpie-Core
NEXT_PUBLIC_GITHUB_PROFILE_OWNER=169Pi
NEXT_PUBLIC_GITHUB_PROFILE_REPO=.github
NEXT_PUBLIC_DISCORD_URL=https://discord.gg/QqkrMmvt4
