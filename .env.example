# Alpie (OpenAI-compatible chat completions)
ALPIE_API_BASE=https://api.169pi.com/v1
ALPIE_API_KEY=pi-...
ALPIE_MODEL=alpie-32b

# GitHub OAuth App
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# Must match "Authorization callback URL" in the OAuth app
GITHUB_REDIRECT_URI=http://localhost:3001/api/auth/callback

# Repo the site tracks
GITHUB_OWNER=169Pi
GITHUB_REPO=Alpie-Core

# Optional: server-side GitHub token used to fetch public repo stats
# (raises rate limit from 60/hr per-IP anonymous to 5,000/hr per-token).
# Any fine-grained PAT with public repo read access works.
GITHUB_TOKEN=

# Cookie signing (any long random string)
SESSION_SECRET=change-me-to-a-32-char-random-string

# Public site URL, used for absolute link-preview (og:image) URLs
NEXT_PUBLIC_SITE_URL=http://localhost:3001
